{
    "files.associations": {
        "*.c": "c",
        "*.h": "c",
        "iosfwd": "cpp",
        "ostream": "cpp",
        "iostream": "cpp",
        "*.tcc": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "string_view": "cpp",
        "cmath": "cpp",
        "iomanip": "cpp",
        "numeric": "cpp",
        "chrono": "cpp",
        "limits": "cpp",
        "valarray": "cpp"
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": false
    },
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": false
    },
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.errorSquiggles": "Disabled",
    "chat.tools.terminal.autoApprove": {
        "/^gcc main\\.c -o main_test\\.exe; if \\(\\$\\?\\) \\{ \\$input_str = \"12 48 01 37 10 18 00`n00 13 26 39 01 02 03`n00 01 02 03 04 05 06`n08 21 34 09 22 10 23`n00 02 04 06 08 25 38`n00 14 28 42 05 06 07\"; \\$input_str \\| \\./main_test\\.exe \\| Out-File -FilePath output\\.txt; Get-Content output\\.txt \\}$/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
}